---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
export const getStaticPaths = (async ({ paginate }) =>
	paginate(await getSortedPosts(), { pageSize: 8 })) satisfies GetStaticPaths;
interface Props {
	page: Page<CollectionEntry<"posts">>;
}
const { page } = Astro.props;
---
<PortfolioLayout title="개발 기록 · 심현보" description="3D 도구와 AI 개발 과정에서 확인한 문제, 판단과 시행착오를 기록합니다.">
	<header class="page-intro"><p class="eyebrow">WRITING / 개발 기록</p><h1>만드는 과정의 기록.</h1><p>구현한 기능뿐 아니라 판단과 시행착오도 함께 남깁니다.</p></header>
	<div class="notes-list">{page.data.map(post => <a class="note-row" href={`/posts/${post.id}/`}><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("ko-KR", { timeZone: "Asia/Seoul" })}</time><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><span aria-hidden="true">↗</span></a>)}</div>
	<nav class="notes-pagination" aria-label="글 페이지">{page.url.prev && <a href={page.url.prev}>← 이전 글</a>}{page.url.next && <a href={page.url.next}>다음 글 →</a>}</nav>
</PortfolioLayout>
