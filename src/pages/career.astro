---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const careerPost = await getEntry("spec", "career");

if (!careerPost) {
	throw new Error("Career page content not found");
}

const { Content } = await render(careerPost);
---

<MainGridLayout
	title="경력"
	description="게임과 VR 클라이언트 개발부터 3D 콘텐츠 제작 도구까지 이어진 심현보의 경력과 주요 프로젝트"
>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
