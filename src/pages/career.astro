---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const careerPost = await getEntry("spec", "career");

if (!careerPost) {
	throw new Error("Career page content not found");
}

const { Content } = await render(careerPost);
---

<MainGridLayout
	title="경력"
	description="Unreal Engine·C++ 기반 3D 콘텐츠 제작 도구 개발자 심현보. Timeline·Camera·Action 편집부터 React·Rust 엔진 연동, 저장·복구와 출력까지의 경력과 대표 프로젝트"
>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<Markdown class="mt-2 [&_h1]:break-keep">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
