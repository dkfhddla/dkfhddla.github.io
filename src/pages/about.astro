---
import { getEntry, render } from "astro:content";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";

const entry = await getEntry("spec", "about");
if (!entry) throw new Error("About content not found");
const { Content } = await render(entry);
---
<PortfolioLayout title="소개 · 심현보"><header class="page-intro"><p class="eyebrow">ABOUT</p><h1>심현보, 그리고 만드는 일.</h1></header><article class="career-document project-prose"><Content /></article></PortfolioLayout>
