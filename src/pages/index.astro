---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Jacob / Dev Notes',
  description: '실시간 3D 도구, 제품 엔지니어링, AI 협업에서 배운 것을 기록합니다.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: '최근 글 읽기',
        href: getBlogPermalink(),
        icon: 'tabler:book-2',
      },
      {
        text: '소개 보기',
        href: getPermalink('/about'),
      },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: '다채로운 3D 형상' }}
  >
    <Fragment slot="title">
      만드는 동안 <span class="whitespace-nowrap">배운 것을</span><br />
      <span class="text-accent dark:text-white">다시 찾을 수 있게</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">Jacob / Dev Notes</span>는 실시간 3D 도구와 제품을 만들며 마주친 문제, 선택한 경계,
      검증한 결과를 기록하는 기술 블로그입니다.
    </Fragment>
  </Hero>

  <Note title="기록하는 방식:" description="문제 · 경계 · 구현 · 검증" />

  <Features
    id="topics"
    tagline="Topics"
    title="주로 다루는 이야기"
    subtitle="완성된 기능만 보여주기보다, 다음 작업에서 다시 사용할 수 있는 판단과 근거를 남깁니다."
    items={[
      {
        title: '실시간 3D 도구',
        description: '복잡한 상호작용을 예측 가능한 편집 경험으로 바꾸는 과정을 다룹니다.',
        icon: 'tabler:box',
      },
      {
        title: '제품 엔지니어링',
        description: '기능 구현에서 검증과 배포까지 이어지는 제품 개발 흐름을 기록합니다.',
        icon: 'tabler:settings-code',
      },
      {
        title: 'AI와 개발하기',
        description: 'AI를 근거를 남기고 함께 판단하는 개발 협업자로 활용하는 방법을 실험합니다.',
        icon: 'tabler:sparkles',
      },
      {
        title: '문제 진단',
        description: '눈에 보이는 현상에서 실제 원인까지 범위를 좁혀 가는 순서를 정리합니다.',
        icon: 'tabler:bug',
      },
      {
        title: '설계 경계',
        description: '시스템과 데이터의 책임을 어디에 둘지 선택한 이유를 설명합니다.',
        icon: 'tabler:arrows-split',
      },
      {
        title: '검증 가능한 기록',
        description: '구현했다는 말보다 다시 확인할 수 있는 테스트와 결과를 남깁니다.',
        icon: 'tabler:list-check',
      },
    ]}
  />

  <Content
    isReversed
    tagline="About this blog"
    title="코드보다 오래 남는 판단을 기록합니다"
    items={[
      {
        title: '왜 필요했는지',
        description: '기능 목록보다 먼저 해결하려던 문제를 설명합니다.',
      },
      {
        title: '무엇이 달라졌는지',
        description: '사용자가 보게 되는 변화와 시스템의 책임을 함께 정리합니다.',
      },
      {
        title: '어디까지 확인했는지',
        description: '검증한 범위와 아직 남은 위험을 구분해 기록합니다.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=2070&q=80',
      alt: '노트북으로 협업하는 개발팀',
    }}
    callToAction={{ text: 'Jacob 소개', href: getPermalink('/about') }}
  >
    <Fragment slot="content">
      같은 문제를 다시 만났을 때 바로 사용할 수 있는 기준을 만드는 것이 이 블로그의 목표입니다.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <BlogLatestPosts
    title="최근 글"
    linkText="모든 글 보기"
    information="개발 과정에서 배운 판단과 검증을 Markdown으로 차곡차곡 쌓아 갑니다."
    count={3}
  />

  <CallToAction
    title="첫 기록부터 읽어보세요"
    subtitle="문제와 해결 사이에서 사라지기 쉬운 판단을 남기기 시작했습니다."
    actions={[
      {
        variant: 'primary',
        text: '블로그로 이동',
        href: getBlogPermalink(),
        icon: 'tabler:arrow-right',
      },
    ]}
  />
</Layout>
