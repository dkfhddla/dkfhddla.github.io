---
import WorkCard from "@/components/portfolio/WorkCard.astro";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import { getSortedProjects } from "@/utils/projects-utils";

const projects = await getSortedProjects();
---
<PortfolioLayout title="프로젝트 · 심현보" description="3D 제작 도구, VR·시뮬레이터와 게임. 심현보가 맡은 역할과 기술적 문제 해결 사례를 살펴보세요.">
	<header class="page-intro"><p class="eyebrow">WORK ARCHIVE / 프로젝트</p><h1>만들어 온 경험들.</h1><p>Unreal Engine 제작 도구에서 웹·Rust 편집기까지.<br />회사·외주·개인 작업을 분야와 기술로 찾아볼 수 있습니다.</p></header>
	<portfolio-gallery>
		<form class="gallery-controls" data-controls hidden role="search" aria-label="프로젝트 검색과 필터">
			<div class="search-field"><label for="work-search">프로젝트 검색</label><input id="work-search" type="search" placeholder="이름, 기술, 분야 검색" aria-controls="work-results" autocomplete="off" /></div>
			<div class="participation-field"><label for="work-engagement">참여 형태</label><select id="work-engagement" aria-controls="work-results"><option value="all">전체</option><option value="company">회사 프로젝트</option><option value="freelance">외주 프로젝트</option><option value="personal">개인·팀 프로젝트</option></select></div>
			<button type="reset" class="filter-reset">초기화</button>
		</form>
		<div class="archive-heading"><h2>프로젝트 목록</h2><p data-count role="status" aria-live="polite" aria-atomic="true">전체 {projects.length}개 프로젝트</p></div>
		<div class="work-grid archive-grid" id="work-results">{projects.map(project => <WorkCard project={project} />)}</div>
		<div class="empty-results" data-empty hidden><h3>조건에 맞는 프로젝트가 없습니다.</h3><p>다른 검색어나 참여 형태를 선택해 보세요.</p><button type="button" class="button secondary" data-reset>전체 프로젝트 보기</button></div>
	</portfolio-gallery>
	<p class="archive-note">각 페이지의 제품 화면·영상은 팀 결과물을 보여 줍니다. 본인 기여와 출시·검증 범위는 별도로 설명합니다.</p>
</PortfolioLayout>
<script>
	import "@/scripts/portfolio-gallery";
</script>
