---
import { type CollectionEntry, render } from "astro:content";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import {
	getSortedProjects,
	projectEngagementLabels,
} from "@/utils/projects-utils";
export async function getStaticPaths() {
	return (await getSortedProjects()).map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}
interface Props {
	entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const {
	title,
	description,
	category,
	period,
	role,
	delivery,
	tags,
	image,
	detailImage,
	organization,
	engagement,
	link,
} = entry.data;
const cover = detailImage || image;
const contents = headings.filter((heading) => heading.depth === 2);
---
<PortfolioLayout title={`${title} · 심현보`} description={description}>
	<article class="project-page">
		<a class="back-link" href="/projects/">← 프로젝트 목록</a>
		<header class="project-title"><p class="eyebrow">{organization || projectEngagementLabels[engagement]} / {category}</p><h1>{title}</h1><p class="project-lead">{description}</p><dl class="project-facts"><div><dt>참여 기간</dt><dd>{period || "프로젝트별 상세 기록 참고"}</dd></div><div><dt>본인 역할</dt><dd>{role || "아래 담당 개발 참고"}</dd></div>{delivery && <div><dt>확인된 결과</dt><dd>{delivery}</dd></div>}</dl><ul class="tech-tags" aria-label="기술과 주제">{tags.map(tag => <li>{tag}</li>)}</ul>{link.length > 0 && <div class="project-source-links">{link.map(({ label, value }) => <a href={value}>{label} ↗</a>)}</div>}</header>
		{cover && <figure class="detail-cover"><img src={cover} alt={`${title} 실제 프로젝트 화면`} width="1280" height="720" /><figcaption>제품·프로젝트의 실제 화면. 팀 결과물과 본인 담당 범위는 아래에서 구분합니다.</figcaption></figure>}
		<div class="project-reading">
			{contents.length > 0 && <aside class="contents"><details open><summary>이 프로젝트에서 읽을 내용</summary><nav aria-label="프로젝트 목차"><ol>{contents.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}</ol></nav></details></aside>}
			<media-gallery class="project-prose"><Content /></media-gallery>
		</div>
		<footer class="project-end"><a class="button primary" href="/projects/">전체 프로젝트 <span aria-hidden="true">↗</span></a><a class="text-link" href="/career/">경력 흐름 보기 ↗</a></footer>
	</article>
	<dialog id="media-dialog" aria-labelledby="media-dialog-title"><div class="dialog-heading"><h2 id="media-dialog-title">프로젝트 이미지</h2><button type="button" data-close autofocus aria-label="이미지 확대 닫기">닫기 ×</button></div><img alt="" /><p>Escape 키로 닫을 수 있습니다.</p></dialog>
</PortfolioLayout>
<script>
	import "@/scripts/portfolio-media";
</script>
